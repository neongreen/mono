#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

BUILD_DIR="$REPO_ROOT/ingest/.dev-build"
mkdir -p "$BUILD_DIR"
BINARY="$BUILD_DIR/ingest"

cd "$REPO_ROOT/ingest"
go build -o "$BINARY" ./cmd

exec "$BINARY" "$@"
