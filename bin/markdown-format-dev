#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

BUILD_DIR="$REPO_ROOT/markdown-format/.dev-build"
mkdir -p "$BUILD_DIR"
BINARY="$BUILD_DIR/markdown-format"

cd "$REPO_ROOT/markdown-format"
go build -o "$BINARY" .

exec "$BINARY" "$@"
