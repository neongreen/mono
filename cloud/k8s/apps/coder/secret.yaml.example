# This file documents what secrets need to be created.
# DO NOT check actual secrets into git!
#
# Secrets are managed via age encryption in cloud/fnox.toml.
# Deploy using: ./cloud/scripts/k8s-secrets.sh
#
# The k8s-secrets.sh script creates coder-secrets with:
#   - POSTGRES_PASSWORD: Shared postgres admin password
#
# Required fnox.toml entries (already configured):
#   N8N_POSTGRES_ADMIN_PASSWORD (used as shared postgres password)
---
apiVersion: v1
kind: Secret
metadata:
  name: coder-secrets
  namespace: coder
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME"
