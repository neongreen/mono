  "layout_constraints": {
    "global_constraints": [
      "Canvas has 24px padding all around",
      "Title is centered horizontally",
      "Title has 24px margin-bottom to panels",
      "Panels have 40px horizontal gap between them",
      "Left and right panels MUST have equal heights",
      "Panels stretch to accommodate their content vertically"
    ],
    "panel_constraints": [
      "Left panel width ~35-40% of total panel width (approximately 450-500px)",
      "Right panel width ~52-60% of total panel width (approximately 750-900px)",
      "Width ratio: left:right approximately 1:1.5 to 1:2",
      "Both panels have 20px internal padding",
      "Both panels have 12px border-radius",
      "Both panels have #fafafa background"
    ],
    "hierarchical_spacing_rules": [
      "Section header to label: 16px (larger gap)",
      "Label to its box: 6px (smaller gap - they logically belong together)",
      "Elements within a box: 8px gap",
      "Rule: Elements that logically belong together have SMALLER spacing than elements that are logically apart"
    ],
    "dashed_box_constraints": [
      "Dashed boxes have ~20px inset from their parent panel edges",
      "Dashed boxes fill remaining height of their parent (after header/label)",
      "All dashed boxes within same panel have equal heights",
      "Border: 2px dashed, #888888, dash: 6px, gap: 4px",
      "Border-radius: 8px",
      "Internal padding: 12-20px"
    ],
    "element_sizing_categories": [
      "Fixed size: speech bubbles (140x40px), doc cards (120x36px), tool pills (120x36px), memory cards (120x36px)",
      "Fixed size: instruction cards (180x36px), message history (140x38px)",
      "Fixed size: neural network grid (3x3, 10px circles, 6px gaps)",
      "Fixed size: output boxes (110-120 x 38px)",
      "Content-based: text elements (title, headers, labels)",
      "Fill-available: spacers inside dashed boxes (represent unused token space)",
      "Parent-based: dashed box widths (parent width minus fixed insets)"
    ],
    "positioning_constraints": [
      "Model grids and output boxes are OUTSIDE panels, positioned beside them",
      "Model grids are vertically centered relative to their adjacent panel",
      "Scissors icons are positioned at bottom-left corner of dashed boxes",
      "Elements in 'possible context' box are left-aligned and stacked vertically",
      "Elements in 'context window' box are left-aligned, some arranged in rows"
    ]
  },
