{
  "name": "diagram-dsl",
  "version": "1.0.0",
  "description": "A high-level DSL for creating diagrams and flowchart-heavy slides using React and JSX",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/examples/basic.tsx",
    "dev:advanced": "tsx src/examples/advanced.tsx",
    "dev:simple": "tsx src/examples/simple.tsx",
    "dev:styled": "tsx src/examples/styled.tsx",
    "examples": "npm run dev:simple && npm run dev && npm run dev:advanced && npm run dev:styled",
    "examples:d2": "tsx src/examples/generate-d2.ts",
    "examples:all": "tsx src/examples/generate-all.ts",
    "test": "tsx src/test/index.test.tsx"
  },
  "keywords": [
    "diagram",
    "flowchart",
    "dsl",
    "react",
    "svg",
    "layout"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
