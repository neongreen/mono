# Example environment variables for mdbook-comments
# Copy this to .env.local and fill in your values

# For remote Supabase deployment (optional)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# For Neon deployment (optional)
# NEON_API_URL=https://your-project.neon.tech/v2/query
# NEON_API_KEY=neon_api_key_xxxxxxxxxxxxx

# Note: Local development with Supabase CLI doesn't need these
# Credentials are auto-generated by 'supabase start'
