{
  "name": "tk",
  "displayName": "tk",
  "description": "View tk tasks inside VS Code.",
  "version": "0.0.1",
  "publisher": "Emily",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neongreen/mono"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:tkExplorer",
    "onView:tkDetailView",
    "onCommand:tk.refresh",
    "onCommand:tk.editTitle",
    "onCommand:tk.rotateStatus",
    "onCommand:tk.createTask",
    "onCommand:tk.createProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tk.refresh",
        "title": "tk: Refresh"
      },
      {
        "command": "tk.editTitle",
        "title": "Edit Title",
        "icon": "$(edit)"
      },
      {
        "command": "tk.rotateStatus",
        "title": "Status",
        "icon": "$(circle-outline)"
      },
      {
        "command": "tk.createTask",
        "title": "Create Task",
        "icon": "$(add)"
      },
      {
        "command": "tk.showTaskDetails",
        "title": "Show Task Details"
      },
      {
        "command": "tk.createProject",
        "title": "Create Project",
        "icon": "$(new-folder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tk.createProject",
          "when": "view == tkExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tk.editTitle",
          "when": "view == tkExplorer && viewItem == tkTask",
          "group": "inline"
        },
        {
          "command": "tk.rotateStatus",
          "when": "view == tkExplorer && viewItem == tkTask",
          "group": "inline"
        },
        {
          "command": "tk.createTask",
          "when": "view == tkExplorer && viewItem == tkGroup",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tkContainer",
          "title": "tk Tasks",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "tkContainer": [
        {
          "id": "tkExplorer",
          "name": "tk"
        },
        {
          "id": "tkDetailView",
          "name": "Task Details",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "tk",
      "properties": {
        "tk.binaryPath": {
          "type": "string",
          "default": "tk",
          "description": "Path to the tk executable."
        },
        "tk.workingDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory to run tk ls --json from. Defaults to the first workspace folder when empty."
        },
        "tk.group": {
          "type": "string",
          "default": "prefix",
          "enum": [
            "prefix",
            "status",
            "none"
          ],
          "description": "Value passed to --group when listing tasks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^18.19.50",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "he": "^1.2.0"
  }
}
